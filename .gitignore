# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is committed (not gitignored): oxvox ships a binary artefact (compiled
# wheels), so we want reproducible builds pinned to exact dependency versions, rather
# than the "leave it out for libraries" advice that applies to crates.io library crates

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Emacs undo tree history files
*~undo-tree~

# Compiled binaries (e.g. by rustimport)
*.so

# Generated by pytest
.hypothesis
.pytest_cache/

# Python cache
__pycache__
.vscode
.mypy_cache/

# Build artefacts
dist/
.venv/
*.egg-info
